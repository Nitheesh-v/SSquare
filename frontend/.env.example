# Server-side NestJS RFQ store. Browsers only call the relative /api/quote route.
# Optional locally: the Next.js route can use .data/inquiries.ndjson as a fallback.
BACKEND_URL=http://127.0.0.1:4000
# Use the SAME strong random value in the backend. Never use NEXT_PUBLIC_ for keys.
RFQ_API_KEY=

# Automatic email delivery (optional). Use a verified sender domain with Resend.
RESEND_API_KEY=
QUOTE_TO_EMAIL=sales@ssquareengg.com
QUOTE_FROM_EMAIL=quotes@ssquareengg.com

# Optional sales-system webhook, also used if email fails. Success is not labelled email.
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_TOKEN=

# Optional public GLB URL/path exported from approved S Square CAD (NOT raw CAD).
# Example: /models/s-square-profile.glb. Keep large assets in approved external storage.
S_SQUARE_CAD_MODEL_URL=
