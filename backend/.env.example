# Local development only. start:prod forces production mode and requires RFQ_API_KEY.
# Resolve the dependency-audit security gate in docs/QA.md before public deployment.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Browsers do not call this internal store directly. Optional comma-separated origins.
CORS_ORIGIN=

# Leave blank for the local single-process JSON store (.data/store.json).
# For production, provide a real MongoDB/Atlas URI and use durable storage/backups.
MONGODB_URI=

# Server-to-server key, matching frontend/.env.local. REQUIRED in production.
RFQ_API_KEY=
