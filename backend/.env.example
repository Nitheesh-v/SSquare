# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=*

# Database (MongoDB)
# Leave MONGODB_URI empty in local sandbox to use the built-in seeded store,
# or provide a live MongoDB / Atlas connection string for full persistence:
MONGODB_URI=mongodb://127.0.0.1:27017/ssquare_engineering

# Authentication (JWT)
JWT_SECRET=ssquare-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
